{
	"schemaVersion": 1,
	"id": "${id}",
	"version": "${version}",
	"name": "${name}",
	"description": "Stop chosen structures from generating, by id or by mod. Based on Disable Structures by Bennyboy1695.",
	"authors": ["traelmyx"],
	"contributors": ["Bennyboy1695 (original mod)"],
	"contact": {
		"sources": "https://github.com/traelmyx/disable-structures-reborn",
		"issues": "https://github.com/traelmyx/disable-structures-reborn/issues"
	},
	"license": "MIT",
	"icon": "assets/disablestructures/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": ["io.github.bennyboy1695.disablestructures.fabric.DisableStructuresFabric"]
	},
	"mixins": ["disablestructures.mixins.json"],
	"depends": {
		"fabricloader": ">=0.16.0",
		"fabric-api": "*",
		"minecraft": "${mc_dep}",
		"java": ">=${java}"
	}
